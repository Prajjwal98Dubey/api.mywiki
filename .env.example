PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# json | mongo
STORAGE_DRIVER=json
DATA_DIR=./data
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# --- MongoDB (used when STORAGE_DRIVER=mongo, and by `npm run migrate:json-to-mongo`) ---
# Atlas: Database → Connect → Drivers. Keep the <db_password> placeholder in the URI:
# the server replaces it with DB_PASSWORD (URL-encoded for you).
# Local: mongodb://127.0.0.1:27017 (no password needed)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/
DB_PASSWORD=your-atlas-db-user-password
# Database name inside the cluster (the URI above doesn't name one)
MONGODB_DB_NAME=mywiki
# Optional: where `npm run test:mongo` creates its throwaway test databases (defaults to MONGODB_URI)
# TEST_MONGODB_URI=

# --- Sign in with Google (optional; enabled when both are set) ---
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → Web application.
# Authorized redirect URI: <PUBLIC_ORIGIN>/api/auth/oauth/google/callback
#   dev (through the Vite proxy): http://localhost:5173/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin users open the site on (used to build the redirect URI). Defaults to CLIENT_ORIGIN.
# PUBLIC_ORIGIN=http://localhost:5173
