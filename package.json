{
  "name": "mywiki-server",
  "version": "1.0.0",
  "private": true,
  "description": "MyWiki backend: Express REST API with JSON-file or MongoDB storage",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test --test-concurrency=1",
    "test:mongo": "node --env-file-if-exists=.env scripts/testMongo.js",
    "migrate:json-to-mongo": "node --env-file-if-exists=.env scripts/migrateJsonToMongo.js",
    "migrate:uploads-to-s3": "node --env-file-if-exists=.env scripts/migrateUploadsToS3.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
